// ==========================================
// НОВАЯ СИСТЕМА ЛОББИ (С НУЛЯ)
// ==========================================

const LOBBY_API = () => window.API_URL || (typeof getApiUrl === 'function' ? getApiUrl() : '');
const LOBBY_UID = () => window.tgUser ? window.tgUser.id : (typeof getUserId === 'function' ? getUserId() : null);
const LOBBY_KEY = 'lumafaceit_secret_e8jd90jd19dd7dk';
const LOBBY_ADMINS = [6999358439, 1135455373, 8863307702, 1244969288, 7938171818, 6372817931, 8594288119];

// ====== ОТРИСОВКА СПИСКА ======
async function fetchAndRenderLobbies() {
    const container = document.getElementById('lobby-list-container');
    if (!container) return;

    try {
        const res = await fetch(LOBBY_API() + '/api/lobbies');
        const lobbies = await res.json();

        if (!lobbies || lobbies.length === 0) {
            container.innerHTML = '<div style="text-align:center;padding:20px;color:#8a7a9b;">Активных лобби нет</div>';
            return;
        }

        const uid = LOBBY_UID();
        container.innerHTML = lobbies.map(l => {
            const players = l.players || [];
            const isMember = uid && l.joined_users && l.joined_users.includes(uid);
            const isFull = l.is_full || (players.length >= l.max_players);
            const isCreator = uid && l.creator_id === uid;
            const isAdmin = LOBBY_ADMINS.includes(uid);

            let btn = isMember
                ? `<button onclick="window.actionLobby('leave', ${l.lobby_id})" style="background:#ef4444;color:#fff;border:none;border-radius:6px;padding:6px 12px;font-size:12px;">Выйти</button>`
                : `<button onclick="window.actionLobby('join', ${l.lobby_id})" ${isFull?'disabled':''} style="background:${isFull?'#333':'#a855f7'};color:#fff;border:none;border-radius:6px;padding:6px 12px;font-size:12px;">${isFull?'Полно':'Войти'}</button>`;

            let delBtn = (isAdmin || isCreator)
                ? `<button onclick="window.actionLobby('delete', ${l.lobby_id})" style="background:rgba(239,68,68,0.2);border:1px solid #ef4444;color:#ef4444;border-radius:6px;padding:4px 8px;margin-left:8px;">✕</button>`
                : '';

            return `
                <div style="background:rgba(21,10,32,0.85);border:1px solid rgba(168,85,247,0.2);border-radius:12px;padding:12px;margin-bottom:12px;">
                    <div style="display:flex;justify-content:space-between;align-items:center;">
                        <div>
                            <span style="color:#fff;font-weight:bold;">Лобби #${l.lobby_id}</span>
                            <span style="color:#a855f7;font-size:12px;margin-left:6px;">${l.mode}</span>
                        </div>
                        <div>${btn}${delBtn}</div>
                    </div>
                    <div style="font-size:11px;color:#8a7a9b;margin-top:4px;">Карта: ${l.map} | Игроков: ${players.length}/${l.max_players}</div>
                </div>`;
        }).join('');
    } catch (e) {
        container.innerHTML = '<div style="color:red;padding:10px;">Ошибка: ' + e.message + '</div>';
    }
}

// ====== ДЕЙСТВИЯ ======
window.actionLobby = async function(action, id) {
    const headers = { 'Content-Type': 'application/json', 'X-API-Key': LOBBY_KEY };
    const uid = LOBBY_UID();
    let endpoint = '';
    let body = { lobby_id: id, user_id: uid };

    if (action === 'join') endpoint = '/api/join_lobby';
    else if (action === 'leave') endpoint = '/api/leave_lobby';
    else if (action === 'delete') {
        endpoint = '/api/close_lobby';
        body = { lobby_id: id, creator_id: uid, admin_id: uid };
    }

    await fetch(LOBBY_API() + endpoint, { method: 'POST', headers, body: JSON.stringify(body) });
    setTimeout(fetchAndRenderLobbies, 500);
};

// ====== МОДАЛКА СОЗДАНИЯ ======
window.openCreateModal = function() {
    let modal = document.getElementById('new-create-modal');
    if (!modal) {
        modal = document.createElement('div');
        modal.id = 'new-create-modal';
        modal.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.8);z-index:99999;display:flex;align-items:center;justify-content:center;';
        modal.innerHTML = `
            <div style="background:#150a20;border:1px solid #a855f7;border-radius:16px;padding:20px;width:90%;max-width:400px;">
                <h3 style="color:#fff;margin:0 0 16px 0;text-align:center;">Создать лобби</h3>
                <div style="margin-bottom:12px;">
                    <div style="color:#8a7a9b;font-size:12px;margin-bottom:8px;">Режим</div>
                    <div style="display:flex;gap:8px;flex-wrap:wrap;" id="new-modes">
                        <button class="m-btn active" data-val="1x1" style="padding:8px 12px;border-radius:8px;border:1px solid #a855f7;background:#a855f7;color:#fff;">1x1</button>
                        <button class="m-btn" data-val="2x2" style="padding:8px 12px;border-radius:8px;border:1px solid #333;background:transparent;color:#fff;">2x2</button>
                        <button class="m-btn" data-val="3x3" style="padding:8px 12px;border-radius:8px;border:1px solid #333;background:transparent;color:#fff;">3x3</button>
                        <button class="m-btn" data-val="4x4" style="padding:8px 12px;border-radius:8px;border:1px solid #333;background:transparent;color:#fff;">4x4</button>
                        <button class="m-btn" data-val="5x5" style="padding:8px 12px;border-radius:8px;border:1px solid #333;background:transparent;color:#fff;">5x5</button>
                    </div>
                </div>
                <div style="margin-bottom:20px;">
                    <div style="color:#8a7a9b;font-size:12px;margin-bottom:8px;">Карта</div>
                    <div style="display:flex;gap:8px;flex-wrap:wrap;" id="new-maps">
                        <button class="mp-btn active" data-val="Sandstone" style="padding:8px 12px;border-radius:8px;border:1px solid #a855f7;background:#a855f7;color:#fff;">Sandstone</button>
                        <button class="mp-btn" data-val="Rust" style="padding:8px 12px;border-radius:8px;border:1px solid #333;background:transparent;color:#fff;">Rust</button>
                        <button class="mp-btn" data-val="Prison" style="padding:8px 12px;border-radius:8px;border:1px solid #333;background:transparent;color:#fff;">Prison</button>
                        <button class="mp-btn" data-val="Hanami" style="padding:8px 12px;border-radius:8px;border:1px solid #333;background:transparent;color:#fff;">Hanami</button>
                    </div>
                </div>
                <div style="display:flex;gap:10px;">
                    <button id="new-cancel" style="flex:1;padding:12px;background:#333;color:#fff;border:none;border-radius:8px;">Отмена</button>
                    <button id="new-confirm" style="flex:1;padding:12px;background:#a855f7;color:#fff;border:none;border-radius:8px;font-weight:bold;">Создать</button>
                </div>
            </div>`;
        document.body.appendChild(modal);

        let selMode = '1x1', selMap = 'Sandstone';
        modal.querySelectorAll('#new-modes .m-btn').forEach(b => {
            b.onclick = () => {
                modal.querySelectorAll('#new-modes .m-btn').forEach(x => { x.style.background = 'transparent'; x.style.borderColor = '#333'; });
                b.style.background = '#a855f7'; b.style.borderColor = '#a855f7';
                selMode = b.dataset.val;
            };
        });
        modal.querySelectorAll('#new-maps .mp-btn').forEach(b => {
            b.onclick = () => {
                modal.querySelectorAll('#new-maps .mp-btn').forEach(x => { x.style.background = 'transparent'; x.style.borderColor = '#333'; });
                b.style.background = '#a855f7'; b.style.borderColor = '#a855f7';
                selMap = b.dataset.val;
            };
        });

        modal.querySelector('#new-cancel').onclick = () => modal.style.display = 'none';
        modal.querySelector('#new-confirm').onclick = async () => {
            modal.style.display = 'none';
            await fetch(LOBBY_API() + '/api/create_lobby', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-API-Key': LOBBY_KEY },
                body: JSON.stringify({ creator_id: LOBBY_UID(), mode: selMode, map: selMap })
            });
            setTimeout(fetchAndRenderLobbies, 1000);
        };
    }
    modal.style.display = 'flex';
};

// ====== ИНИЦИАЛИЗАЦИЯ ======
window.addEventListener('load', () => {
    setTimeout(() => {
        const createBtn = document.getElementById('new-create-lobby');
        if (createBtn) {
            createBtn.onclick = (e) => {
                e.preventDefault();
                window.openCreateModal();
            };
        }
        fetchAndRenderLobbies();
        setInterval(fetchAndRenderLobbies, 3000);
    }, 1500);
});
